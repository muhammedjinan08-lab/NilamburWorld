[physics]

3d/default_gravity=9.8
3d/default_gravity_vector=Vector3(0, -1, 0)

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=true
scaling_3d/mode=1
scaling_3d/scale=1.0
environment/volumetric_fog/volume_size=64
environment/volumetric_fog/volume_depth=128
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
occlusion_culling/use_occlusion_culling=true
textures/vram_compression/import_etc2_astc=false

[autoload]

GameManager="*res://scripts/core/GameManager.gd"
MultiplayerManager="*res://scripts/multiplayer/MultiplayerManager.gd"
QuestManager="*res://scripts/gameplay/QuestManager.gd"
AudioManager="*res://scripts/core/AudioManager.gd"
